# StockSmart Environment Configuration Template
# Backend (Django) Configuration
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# CORS Configuration
# Include your frontend domains (e.g. GitHub Pages URL, localhost)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourusername.github.io

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend (Vite) Configuration (put in frontend/.env if needed)
VITE_API_BASE_URL=http://localhost:8000/api
# In production on GitHub Pages pointing to Render backend:
# VITE_API_BASE_URL=https://stocksmart-backend.onrender.com/api

# Required only when running the local seed_data management command
STOCKSMART_SEED_PASSWORD=
